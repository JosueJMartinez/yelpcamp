<% layout('layouts/boilerplate') %>
<!-- <section class="container"> -->
<div class="row">
  <h1 class="text-center">Edit Campground </h1>
  <div class="col-6 offset-3">
    <h1 class="text-center"><%= campground.name %></h1>
    <form action="/campgrounds/<%= campground._id %>?_method=PATCH" method="POST">
      <div class="form-group">
        <div class="mb-3">
          <label for="price">Price: </label>
          <input type="text" class="form-control" id="price" name="price" value="<%= campground.price %>" required>
        </div>
        <div class="mb-3">
          <label for="description">Description: </label>
          <textarea class="form-control" id="description" name="description" rows="3"><%= campground.description %></textarea>
        </div>
        <div class="mb-3">
          <label for="city">City: </label>
          <input type="text" class="form-control" id="city" name="city" value="<%= campground.city %>" required>
        </div>
        <div class="mb-3">
          <select class="form-select" id="state" name="state" aria-label="Default select example">
            <option selected>Select A State</option>
            <% states.forEach(state=>{ %>
            <option value=<%= `${state.name}` %> <%= state.name == campground.state ? 'selected':'' %>><%= `${state.name}` %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <a class="btn btn-danger" href=<%=  `/campgrounds/${campground._id}` %> role="button">Cancel</a>
      <button type="submit" class="btn btn-primary">Update</button>
    </form>
  </div>
</div>
<!-- </section> -->