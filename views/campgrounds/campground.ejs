<% layout('layouts/boilerplate') %>


<!-- <div class="card mt-5 mb-5"> -->
<img src=<%= campground.imgLg %> class="card-img-top" alt="...">
<div class="card-body">
  <h4 class="card-title"><%= campground.name %></h4>
  <p class="card-text"><%= campground.description %></p>
</div>
<ul class="list-group list-group-flush">
  <li class="list-group-item"><%= campground.location %>
    <span class="float-end">$<%= campground.price %></span>
  </li>
</ul>
<div class="card-body flex-row gap-4">
  <a class="btn btn-primary" href="/campgrounds" role="button">Back</a>
  <a class="btn btn-warning" href=<%= `/campgrounds/${campground.id}/edit` %> role="button">Edit</a>
  <form action="/campgrounds/<%=campground.id%>?_method=DELETE" method="POST" class="d-inline">
    <button class="btn btn-danger" type="submit">Delete</button>
  </form>
</div>
<!-- </div> -->