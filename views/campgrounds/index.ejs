<%- include('../partials/header', { page }) %>
<%- include('../partials/navbar') %>
<section class="container">
  <h1><%- page %> page</h1>
  <a class="btn btn-primary" href='/campgrounds/create' role="button">Create Campground</a>
  <div>
    <div class="mt-5">
      <% for(let i=0; i< 18; i=i+3 ){%>
      <div class="row mb-5">
        <% for(let j=i; j<i+3 && j<18 ;j++){ %>
        <div class="col">
          <a href=<%=`/campgrounds/${campgrounds[j].id}` %> class="card h-100">
            <img src="..." class="card-img-top" alt="...">
            <div class="card-body">
              <h4 class="card-title"><%= campgrounds[j].name %></h4>
              <p class="card-text"><%= campgrounds[j].description %></p>
            </div>
            <ul class="list-group list-group-flush">
              <li class="list-group-item">$<%= campgrounds[j].price %></li>
              <li class="list-group-item"><%= campgrounds[j].location %></li>
            </ul>
          </a>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>